# Contraseña para acceder a /dashboard
DASHBOARD_PASSWORD=

# Secreto usado para firmar la cookie de sesión (cualquier string largo y aleatorio)
# Generar uno con: openssl rand -hex 32
AUTH_SECRET=

# Clave de cifrado AES-256 para la bóveda de "Hiper Seguridad" (64 caracteres hex = 32 bytes)
# Generar una con: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=

# Token de lectura/escritura del Vercel Blob store donde se guarda la bóveda cifrada.
# Se genera automáticamente al conectar un Blob store al proyecto en Vercel
# (Storage → Create Database → Blob), o localmente con: npx vercel env pull
BLOB_READ_WRITE_TOKEN=
